import pandas as pd
import matplotlib.pyplot as plt
import matplotlib


data = pd.read_csv("temp_data.csv")

plt.plot(data["Time_s"], data["Temp_F"])
plt.xlabel("Time (seconds)")
plt.ylabel("Temperature (F)")
plt.title("Materials Cooling Curve")
plt.grid()

plt.savefig("graph.png")
print("GRAPH SAVED")
plt.show()
